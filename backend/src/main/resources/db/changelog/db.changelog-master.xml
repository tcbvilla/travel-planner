<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- 完整数据库初始化 -->
    <include file="changesets/000-complete-init.xml" relativeToChangelogFile="true"/>
    
    <!-- 添加惩罚相关字段 -->
    <include file="changesets/001-add-penalty-fields.xml" relativeToChangelogFile="true"/>
    
    <!-- 允许 settlement_records 的 attendance_session_id 为空 -->
    <include file="changesets/002-allow-null-attendance-session-id.xml" relativeToChangelogFile="true"/>
    
    <!-- 添加加成配置表 -->
    <include file="changesets/003-add-bonus-config.xml" relativeToChangelogFile="true"/>
    
    <!-- 权限系统表结构 -->
    <include file="changesets/005-auth-system.xml" relativeToChangelogFile="true"/>
    
    <!-- 添加缺失的列 -->
    <include file="changesets/006-add-missing-columns.xml" relativeToChangelogFile="true"/>
    
    <!-- 初始化角色数据 -->
    <include file="changesets/007-init-roles-data.xml" relativeToChangelogFile="true"/>
    
    <!-- 添加缺失的权限 -->
    <include file="changesets/008-add-missing-permissions.xml" relativeToChangelogFile="true"/>
    
    <!-- 简化权限系统 -->
    <include file="changesets/009-simplify-permissions.xml" relativeToChangelogFile="true"/>
    
    <!-- 修复SUPER_ADMIN角色和简化权限（确保新环境正确初始化） -->
    <include file="changesets/010-fix-super-admin-and-permissions.xml" relativeToChangelogFile="true"/>

    <!-- 添加支付记录表和支付管理权限 -->
    <include file="changesets/011-add-payment-records.xml" relativeToChangelogFile="true"/>

    <!-- 添加团徽表 -->
    <include file="changesets/012-add-team-logos.xml" relativeToChangelogFile="true"/>

    <!-- 添加排名排除名单表 -->
    <include file="changesets/013-add-ranking-exclusions.xml" relativeToChangelogFile="true"/>

    <!-- 添加分组配置表 -->
    <include file="changesets/014-add-group-config.xml" relativeToChangelogFile="true"/>

    <!-- 添加系统配置表 -->
    <include file="changesets/015-add-system-config.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>