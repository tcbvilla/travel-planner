    <changeSet id="000-004" author="dev-team">
        <comment>添加约束和检查</comment>
        
        <!-- 现金奖励约束 -->
        <sql>
            ALTER TABLE settlement_records 
            ADD CONSTRAINT chk_cash_reward_mode 
            CHECK ((reward_mode = 'CASH' AND cash_amount IS NOT NULL) OR (reward_mode = 'CODE_TABLE' AND code_value IS NOT NULL));
        </sql>
        
        <!-- 赛季日期约束 -->
        <sql>
            ALTER TABLE seasons 
            ADD CONSTRAINT chk_seasons_dates 
            CHECK (start_date &lt;= end_date);
        </sql>
        
        <!-- 考勤类型注释 -->
        <sql>
            COMMENT ON COLUMN attendance_sessions.attendance_type IS '考勤类型：压秒考勤、区间战功考勤、区间助攻考勤、晨练考勤、夜战考勤、其他';
        </sql>

    </changeSet>

    <changeSet id="000-005" author="dev-team">
        <comment>创建视图和函数</comment>
        
        <!-- 活跃结算记录视图 -->
        <sql>
            CREATE OR REPLACE VIEW active_settlement_records AS
            SELECT 
                sr.*,
                s.name as season_name,
                as1.name as attendance_session_name
            FROM settlement_records sr
            LEFT JOIN attendance_sessions as1 ON sr.attendance_session_id = as1.id
            LEFT JOIN seasons s ON as1.season_id = s.id
            WHERE sr.record_status = 'ACTIVE';
        </sql>
        
        <!-- 赛季状态视图 -->
        <sql>
            CREATE OR REPLACE VIEW season_status_view AS
            SELECT 
                id,
                name,
                start_date,
                end_date,
                CASE 
                    WHEN start_date &gt; CURRENT_DATE THEN '未开始'
                    WHEN end_date &lt; CURRENT_DATE THEN '已完结'
                    ELSE '进行中'
                END as status,
                created_at,
                updated_at
            FROM seasons;
        </sql>
        
        <!-- 团队物品汇总函数 -->
        <sql>
            CREATE OR REPLACE FUNCTION get_team_items_summary(season_id_param BIGINT)
            RETURNS TABLE (
                team_name VARCHAR(100),
                item_type VARCHAR(50),
                total_quantity NUMERIC(10,3),
                total_cash NUMERIC(15,2)
            ) AS $$
            BEGIN
                RETURN QUERY
                SELECT 
                    sr.team_name,
                    COALESCE(sr.code_value, '现金') as item_type,
                    SUM(sr.quantity) as total_quantity,
                    SUM(COALESCE(sr.cash_amount, 0)) as total_cash
                FROM settlement_records sr
                LEFT JOIN attendance_sessions as1 ON sr.attendance_session_id = as1.id
                WHERE as1.season_id = season_id_param 
                    AND sr.record_status = 'ACTIVE'
                GROUP BY sr.team_name, COALESCE(sr.code_value, '现金')
                ORDER BY sr.team_name, item_type;
            END
            $$ LANGUAGE plpgsql;
        </sql>
        
        <!-- 更新时间触发器函数 -->
        <sql>
            CREATE OR REPLACE FUNCTION update_updated_at_column()
            RETURNS TRIGGER AS $$
            BEGIN
                NEW.updated_at = CURRENT_TIMESTAMP;
                RETURN NEW;
            END
            $$ LANGUAGE plpgsql;
        </sql>
        
        <!-- 为需要的表创建更新时间触发器 -->
        <sql>
            CREATE TRIGGER trigger_seasons_updated_at
                BEFORE UPDATE ON seasons
                FOR EACH ROW
                EXECUTE FUNCTION update_updated_at_column();
                
            CREATE TRIGGER trigger_attendance_sessions_updated_at
                BEFORE UPDATE ON attendance_sessions
                FOR EACH ROW
                EXECUTE FUNCTION update_updated_at_column();
                
            CREATE TRIGGER trigger_reward_conditions_updated_at
                BEFORE UPDATE ON reward_conditions
                FOR EACH ROW
                EXECUTE FUNCTION update_updated_at_column();
        </sql>

    </changeSet>

