    <changeSet id="000-002" author="dev-team">
        <comment>创建外键约束</comment>
        
        <!-- 考勤会话 -> 赛季 -->
        <addForeignKeyConstraint baseTableName="attendance_sessions" baseColumnNames="season_id"
                                 constraintName="fk_attendance_sessions_season"
                                 referencedTableName="seasons" referencedColumnNames="id"/>
        
        <!-- 奖惩条件 -> 考勤会话 -->
        <addForeignKeyConstraint baseTableName="reward_conditions" baseColumnNames="attendance_session_id"
                                 constraintName="fk_reward_conditions_session"
                                 referencedTableName="attendance_sessions" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        
        <!-- 结算记录 -> 考勤会话 -->
        <addForeignKeyConstraint baseTableName="settlement_records" baseColumnNames="attendance_session_id"
                                 constraintName="fk_settlement_records_session"
                                 referencedTableName="attendance_sessions" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        
        <!-- 结算日志 -> 考勤会话 -->
        <addForeignKeyConstraint baseTableName="settlement_logs" baseColumnNames="attendance_session_id"
                                 constraintName="fk_settlement_logs_session"
                                 referencedTableName="attendance_sessions" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        
        <!-- 合成链 -> 赛季 -->
        <addForeignKeyConstraint baseTableName="synthesis_chains" baseColumnNames="season_id"
                                 constraintName="fk_synthesis_chains_season"
                                 referencedTableName="seasons" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        
        <!-- 合成链 -> 考勤会话 -->
        <addForeignKeyConstraint baseTableName="synthesis_chains" baseColumnNames="attendance_session_id"
                                 constraintName="fk_synthesis_chains_attendance_session"
                                 referencedTableName="attendance_sessions" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        
        <!-- 合成日志 -> 合成链 -->
        <addForeignKeyConstraint baseTableName="synthesis_logs" baseColumnNames="synthesis_chain_id"
                                 constraintName="fk_synthesis_logs_chain"
                                 referencedTableName="synthesis_chains" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        
        <!-- 奖惩记录 -> 成员 -->
        <addForeignKeyConstraint baseTableName="reward_records" baseColumnNames="member_id"
                                 constraintName="fk_reward_records_member"
                                 referencedTableName="members" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

    </changeSet>

