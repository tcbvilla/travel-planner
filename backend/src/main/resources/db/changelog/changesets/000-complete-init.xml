                <constraints nullable="false"/>
            </column>
            <column name="attendance_rate" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP">
                <constraints nullable="false"/>
