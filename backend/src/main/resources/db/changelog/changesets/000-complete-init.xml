            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="member_data" type="TEXT"/>
            <column name="group_data" type="TEXT"/>
            <column name="threshold" type="INTEGER"/>
            <column name="start_time" type="TIMESTAMP"/>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="season_id" type="BIGINT"/>
            <column name="attendance_type" type="VARCHAR(50)" defaultValue="压秒考勤">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 创建成员表 -->
        <createTable tableName="members">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="group_name" type="VARCHAR(100)">
