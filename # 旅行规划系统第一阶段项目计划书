### 5.3 状态管理设计

**Zustand状态设计：**
```typescript
// stores/planStore.ts
interface PlanState {
  // 状态数据
  currentPlan: TravelPlan | null;
  events: Event[];
  expenses: Expense[];
  loading: boolean;
  error: string | null;
  
  // 操作方法
  setCurrentPlan: (plan: TravelPlan) => void;
  addEvent: (event: Event) => void;
  updateEvent: (eventId: string, updates: Partial<Event>) => void;
  deleteEvent: (eventId: string) => void;
  reorderEvents: (eventIds: string[]) => void;
  
  addExpense: (expense: Expense) => void;
  updateExpense: (expenseId: string, updates: Partial<Expense>) => void;
  deleteExpense: (expenseId: string) => void;
  
  // 异步操作
  fetchPlan: (planId: string) => Promise<void>;
  savePlan: () => Promise<void>;
  autoGenerateTransport: () => Promise<void>;
}

const usePlanStore = create<PlanState>((set, get) => ({
  currentPlan: null,
  events: [],
  expenses: [],
  loading: false,
  error: null,
  
  setCurrentPlan: (plan) => set({ currentPlan: plan }),
  
  addEvent: (event) => set((state) => ({
    events: [...state.events, event]
  })),
  
  updateEvent: (eventId, updates) => set((state) => ({
    events: state.events.map(event => 
      event.id === eventId ? { ...event, ...updates } : event
    )
  })),
  
  deleteEvent: (eventId) => set((state) => ({
    events: state.events.filter(event => event.id !== eventId)
  })),
  
  fetchPlan: async (planId) => {
    set({ loading: true, error: null });
    try {
      const plan = await planService.getPlan(planId);
      const events = await eventService.getEvents(planId);
      const expenses = await expenseService.getExpenses(planId);
      set({ currentPlan: plan, events, expenses, loading: false });
    } catch (error) {
      set({ error: error.message, loading: false });
    }
  },
  
  // 其他方法实现...
}));
```

