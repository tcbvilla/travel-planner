## 3. 数据库设计

### 3.1 核心数据模型

**用户相关表：**
```sql
-- 用户表
CREATE TABLE users (
    id BIGSERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    nickname VARCHAR(50),
    avatar_url VARCHAR(500),
    phone VARCHAR(20),
    birth_date DATE,
    gender SMALLINT, -- 0:未知, 1:男, 2:女
    country VARCHAR(50),
    city VARCHAR(50),
    timezone VARCHAR(50) DEFAULT 'Asia/Shanghai',
    language VARCHAR(10) DEFAULT 'zh-CN',
    status SMALLINT DEFAULT 1, -- 0:禁用, 1:正常, 2:锁定
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    last_login_at TIMESTAMP
);

-- 用户偏好表
CREATE TABLE user_preferences (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT REFERENCES users(id),
    travel_pace SMALLINT DEFAULT 2, -- 1:慢节奏, 2:适中, 3:紧凑
    budget_level SMALLINT DEFAULT 2, -- 1:经济, 2:标准, 3:豪华, 4:不限
    accommodation_priority SMALLINT DEFAULT 1, -- 1:位置, 2:价格, 3:体验
    transport_priority SMALLINT DEFAULT 1, -- 1:时间, 2:价格, 3:舒适
    activity_preferences JSONB, -- 活动类型偏好JSON
    dietary_restrictions JSONB, -- 饮食限制JSON
    accessibility_needs JSONB, -- 无障碍需求JSON
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
```

**旅行计划相关表：**
```sql
-- 旅行计划表
CREATE TABLE travel_plans (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT REFERENCES users(id),
    title VARCHAR(200) NOT NULL,
    description TEXT,
    main_destination VARCHAR(100) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    participant_count INTEGER DEFAULT 1,
    total_budget DECIMAL(12,2),
    currency VARCHAR(3) DEFAULT 'CNY',
    travel_type SMALLINT DEFAULT 1, -- 1:休闲, 2:商务, 3:探亲, 4:学习
    travel_style SMALLINT DEFAULT 1, -- 1:自由行, 2:跟团, 3:半自助
    privacy_level SMALLINT DEFAULT 1, -- 1:私人, 2:朋友, 3:公开
    status SMALLINT DEFAULT 1, -- 1:草稿, 2:进行中, 3:已完成, 4:已取消
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_user_status (user_id, status),
    INDEX idx_destination_date (main_destination, start_date)
);

-- 旅行计划参与者表
CREATE TABLE travel_plan_participants (
    id BIGSERIAL PRIMARY KEY,
    plan_id BIGINT REFERENCES travel_plans(id),
    user_id BIGINT REFERENCES users(id),
    role SMALLINT DEFAULT 1, -- 1:创建者, 2:编辑者, 3:查看者
    nickname VARCHAR(50),
    join_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(plan_id, user_id)
);
```

**事件相关表：**
```sql
-- 活动事件表（景点和住宿）
CREATE TABLE activity_events (
    id BIGSERIAL PRIMARY KEY,
    plan_id BIGINT REFERENCES travel_plans(id),
    event_type SMALLINT NOT NULL, -- 1:景点, 2:住宿
    name VARCHAR(200) NOT NULL,
    description TEXT,
    address VARCHAR(500),
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8),
    city VARCHAR(100),
    country VARCHAR(50),
    contact_phone VARCHAR(50),
    contact_email VARCHAR(100),
    website_url VARCHAR(500),
    
    -- 时间安排
    event_date DATE NOT NULL,
    start_time TIME,
    end_time TIME,
    duration_hours DECIMAL(4,2),
    
    -- 景点特有字段
    attraction_type VARCHAR(50), -- 自然风光、人文古迹等
    opening_hours JSONB, -- 营业时间JSON
    ticket_price DECIMAL(10,2),
    rating DECIMAL(3,2),
    
    -- 住宿特有字段
    accommodation_type VARCHAR(50), -- 酒店、民宿等
    checkin_time TIME,
    checkout_time TIME,
    room_type VARCHAR(100),
    include_breakfast BOOLEAN DEFAULT FALSE,
    cancellation_policy TEXT,
    nightly_rate DECIMAL(10,2),
    
    -- 费用信息
    estimated_cost DECIMAL(10,2),
    actual_cost DECIMAL(10,2),
    cost_currency VARCHAR(3) DEFAULT 'CNY',
    cost_notes TEXT,
    
    -- 状态和元数据
    status SMALLINT DEFAULT 1, -- 1:计划中, 2:已确认, 3:已完成, 4:已取消
    sort_order INTEGER DEFAULT 0,
    auto_generated BOOLEAN DEFAULT FALSE, -- 是否自动生成
    external_id VARCHAR(100), -- 外部系统ID
    metadata JSONB, -- 扩展信息
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    INDEX idx_plan_date (plan_id, event_date),
    INDEX idx_plan_type (plan_id, event_type),
    INDEX idx_location (latitude, longitude)
);

-- 交通事件表
CREATE TABLE transport_events (
    id BIGSERIAL PRIMARY KEY,
    plan_id BIGINT REFERENCES travel_plans(id),
    from_event_id BIGINT REFERENCES activity_events(id),
    to_event_id BIGINT REFERENCES activity_events(id),
    
    transport_type SMALLINT NOT NULL, -- 1:飞机, 2:火车, 3:汽车, 4:轮船, 5:其他
    transport_name VARCHAR(200), -- 航班号、车次号等
    
    departure_location VARCHAR(200),
    arrival_location VARCHAR(200),
    departure_date DATE NOT NULL,
    departure_time TIME,
    arrival_date DATE,
    arrival_time TIME,
    duration_hours DECIMAL(5,2),
    
    -- 预订信息
    booking_reference VARCHAR(100),
    seat_class VARCHAR(50), -- 座位等级
    seat_number VARCHAR(20),
    baggage_allowance VARCHAR(100),
    
    -- 费用信息
    ticket_price DECIMAL(10,2),
    additional_fees DECIMAL(10,2),
    total_cost DECIMAL(10,2),
    cost_currency VARCHAR(3) DEFAULT 'CNY',
    
    -- 政策信息
    cancellation_policy TEXT,
    change_policy TEXT,
    refund_policy TEXT,
    
    -- 状态和元数据
    booking_status SMALLINT DEFAULT 1, -- 1:未预订, 2:已预订, 3:已确认, 4:已完成
    auto_generated BOOLEAN DEFAULT FALSE,
    sort_order INTEGER DEFAULT 0,
    notes TEXT,
    metadata JSONB,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    INDEX idx_plan_date (plan_id, departure_date),
    INDEX idx_from_to (from_event_id, to_event_id)
);
```

**费用相关表：**
```sql
-- 费用记录表
CREATE TABLE expense_records (
    id BIGSERIAL PRIMARY KEY,
    plan_id BIGINT REFERENCES travel_plans(id),
    event_id BIGINT, -- 关联的事件ID（可能是activity_events或transport_events）
    event_type SMALLINT, -- 1:活动事件, 2:交通事件, 3:其他
    
    category SMALLINT NOT NULL, -- 1:交通, 2:住宿, 3:景点, 4:餐饮, 5:购物, 6:其他
    subcategory VARCHAR(50), -- 子分类
    
    description VARCHAR(200) NOT NULL,
    amount DECIMAL(10,2) NOT NULL,
    currency VARCHAR(3) DEFAULT 'CNY',
    exchange_rate DECIMAL(10,6) DEFAULT 1.0, -- 对人民币汇率
    amount_cny DECIMAL(10,2), -- 人民币金额
    
    expense_date DATE NOT NULL,
    payment_method SMALLINT, -- 1:现金, 2:信用卡, 3:借记卡, 4:移动支付, 5:其他
    payment_status SMALLINT DEFAULT 1, -- 1:未支付, 2:已支付, 3:已退款
    
    payer_id BIGINT REFERENCES users(id), -- 付款人
    participants JSONB, -- 参与分摊的人员和比例
    
    receipt_url VARCHAR(500), -- 收据图片URL
    notes TEXT,
    tags JSONB, -- 标签数组
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    INDEX idx_plan_date (plan_id, expense_date),
    INDEX idx_plan_category (plan_id, category),
    INDEX idx_payer (payer_id)
);

-- 预算表
CREATE TABLE budgets (
    id BIGSERIAL PRIMARY KEY,
    plan_id BIGINT REFERENCES travel_plans(id),
    category SMALLINT NOT NULL, -- 费用分类
    allocated_amount DECIMAL(10,2) NOT NULL,
    spent_amount DECIMAL(10,2) DEFAULT 0,
    currency VARCHAR(3) DEFAULT 'CNY',
    notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(plan_id, category)
);
```

### 3.2 索引和优化策略

**主要索引设计：**
```sql
-- 复合索引优化查询性能
CREATE INDEX idx_travel_plans_user_status_date ON travel_plans(user_id, status, start_date DESC);
CREATE INDEX idx_activity_events_plan_date_type ON activity_events(plan_id, event_date, event_type);
CREATE INDEX idx_transport_events_plan_departure ON transport_events(plan_id, departure_date);
CREATE INDEX idx_expense_records_plan_date_category ON expense_records(plan_id, expense_date, category);

-- 地理位置索引
CREATE INDEX idx_activity_events_location ON activity_events USING GIST(point(longitude, latitude));

-- 全文搜索索引
CREATE INDEX idx_travel_plans_search ON travel_plans USING GIN(to_tsvector('simple', title || ' ' || description));
CREATE INDEX idx_activity_events_search ON activity_events USING GIN(to_tsvector('simple', name || ' ' || description));
```

